# ── MCP connector protection ───────────────────────────────
# Any long random string. The connector URL becomes:
#   https://YOUR-APP.vercel.app/api/mcp?key=THIS_VALUE
MCP_SECRET=

# ── Job storage (Upstash Redis via Vercel Marketplace) ──────
# Added automatically when you connect "Upstash for Redis" in Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Google Docs output ─────────────────────────────────────
# Folder where docs are created (ID from the folder URL).
GOOGLE_DRIVE_FOLDER_ID=
# Optional: also give this email edit access to every doc.
SHARE_WITH_EMAIL=

# Option 1 — OAuth as YOUR Google account (works with normal My Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Option 2 — Service account (folder must be in a Shared Drive)
# Paste the whole JSON key on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
